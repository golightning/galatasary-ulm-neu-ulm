# Database
DATABASE_URL="postgresql://user:password@localhost:5432/galatasaray_members?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin-Seed (Pflichtfeld bei npm run db:seed)
ADMIN_SEED_PASSWORD="change-me-before-production"

# Resend (E-Mail)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Galatasaray Ulm <noreply@galatasaray-ulm.de>"

# Apple Wallet
APPLE_PASS_TYPE_ID="pass.de.galatasaray-ulm.member"
APPLE_TEAM_ID="YOUR_TEAM_ID"
# Produktion (Vercel): Zertifikate als Base64-Strings
# base64 -i certs/pass.pem | tr -d '\n'
APPLE_CERT_PEM_BASE64=""
# base64 -i certs/pass-key.pem | tr -d '\n'
APPLE_KEY_PEM_BASE64=""
# base64 -i certs/wwdr.pem | tr -d '\n'
APPLE_WWDR_PEM_BASE64=""
# Lokal (Fallback): Dateipfade werden automatisch genutzt wenn Env-Vars leer

# Google Wallet
GOOGLE_WALLET_ISSUER_ID="your-google-wallet-issuer-id"
GOOGLE_WALLET_CLASS_ID="galatasaray-ulm-member"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-sa@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./certs/google-sa-key.json"
# Produktion (Vercel): JSON-Inhalt direkt als Variable
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account",...}'

# QR-Code Signierung
QR_SIGNING_SECRET="generate-a-long-random-secret-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLUB_NAME="Galatasaray Ulm/Neu-Ulm"

# Vercel Cron (automatisch von Vercel gesetzt; lokal für manuelle Tests setzen)
# WICHTIG: Muss in Vercel Project Settings → "Cron Job Secret" eingetragen werden,
# damit Vercel bei jedem Cron-Aufruf automatisch "Authorization: Bearer <CRON_SECRET>" sendet.
CRON_SECRET="generate-with-openssl-rand-base64-32"
